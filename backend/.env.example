PORT=8080
DATABASE_URL=postgres://lovelybar:lovelybar@localhost:5432/lovelybar?sslmode=disable
UPLOAD_DIR=./uploads
# Origin of the frontend when it is served from a different host (leave empty in dev: Vite proxies /api)
FRONTEND_ORIGIN=
# Insert 4 demo products when the products table is empty
SEED_SAMPLE=true

# Receiving bank account for VietQR (backend only, never sent to the frontend).
# Supported codes: VCB MB BIDV TCB ACB CTG VPB TPB STB VIB HDB SHB MSB OCB LPB VBA
PAYMENT_BANK_CODE=BIDV
PAYMENT_BANK_ACCOUNT=1440250089
PAYMENT_BANK_NAME=Phan Thanh Hậu
# Optional: 6-digit NAPAS BIN, only for banks not in the built-in list
# PAYMENT_BANK_BIN=
